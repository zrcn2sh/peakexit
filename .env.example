# ────────────────────────────────────────
# 한국투자증권 API 설정
# ────────────────────────────────────────
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=12345678-01
KIS_IS_MOCK=true          # 처음엔 반드시 true로 테스트

# USD→KRW (시드 대비 합산용). 비우면 공개 API로 조회(1시간 캐시). API 실패 시만 임시로 숫자 지정.
# FX_USD_KRW=1450

# 데이터 저장 경로 (선택, 미설정 시 Linux/Docker=/data, Windows=backend/data)
# PEAKEXIT_DATA_DIR=/data

# ────────────────────────────────────────
# 텔레그램 설정
# 봇 생성: https://t.me/BotFather → /newbot
# Chat ID: https://t.me/userinfobot
# ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789
